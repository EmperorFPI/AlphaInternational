{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alpha-international",
  "compatibility_date": "2026-09-23",

  // Assets-only Worker: no `main` script, Cloudflare serves ./public directly.
  "assets": {
    "directory": "./public",

    // Placeholder site — every path should land on the holding page rather
    // than a bare 404. Revisit when the real site ships (see README).
    "not_found_handling": "single-page-application"
  },

  // Requires alphainternational.energy to be an active zone on this account.
  "routes": [
    { "pattern": "alphainternational.energy", "custom_domain": true },
    { "pattern": "www.alphainternational.energy", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  }
}
