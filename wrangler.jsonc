{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alpha-international",
  "compatibility_date": "2026-09-23",

  // The site is static; this script exists only to relay the contact form so
  // that the HighLevel webhook URL stays in a secret instead of page source.
  "main": "src/index.js",

  "assets": {
    "directory": "./public",

    // Lets the Worker hand everything that is not /api/contact to the assets.
    "binding": "ASSETS",

    // The asset router would otherwise answer /api/contact with index.html
    // before the Worker ever ran, because of the SPA fallback below.
    "run_worker_first": ["/api/*"],

    // One-page-per-route site: an unmatched path lands on the homepage rather
    // than a bare 404. See the README for the trade-off.
    "not_found_handling": "single-page-application"
  },

  // Requires alphainternational.energy to be an active zone on this account.
  "routes": [
    { "pattern": "alphainternational.energy", "custom_domain": true },
    { "pattern": "www.alphainternational.energy", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  }
}
